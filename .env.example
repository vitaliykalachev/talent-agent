# Провайдер ИИ-модели. anthropic — Anthropic Messages API (в том числе прокси ClaudeHub);
# openai — любой OpenAI-совместимый сервер (например, YandexGPT).
LLM_PROVIDER=anthropic
LLM_BASE_URL=https://api.claudehub.fun
LLM_API_KEY=положите-ключ-сюда
# Модель для разбора резюме (дешёвая) и для оценки под вакансию (умнее)
LLM_MODEL_PARSE=claude-haiku-4.5
LLM_MODEL_EVAL=claude-sonnet-5
# Модель смыслового поиска (локально, на этом компьютере). Запасной вариант:
# intfloat/multilingual-e5-base. Вес кэшируется в data/models/ (TA_MODELS_DIR).
EMBED_MODEL=sergeyzh/BERTA
